# Database Configuration (Docker PostgreSQL)
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/sat_lab_db

# Security & Token Authentication
API_SECRET_TOKEN=change_this_secret_token_in_production
JWT_SECRET_KEY=change_this_jwt_secret_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# MQTT Broker Configuration
MQTT_BROKER="192.168.10.208"
MQTT_PORT=1883
MQTT_USER="sat_lab"
MQTT_PASSWORD="your_mqtt_password"
MQTT_TOPIC_PREFIX="edge/gateway"
MQTT_TOPIC_SUB="sat_lab/telemetry/#"
MQTT_CLIENT_ID="sat_lab_backend_worker"
